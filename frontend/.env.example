# Local development (Docker / local backend)
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001/api/ws

# Optional production scene tile CDN/object-store template
# Example: https://cdn.example.com/streept/scene/{z}/{x}/{y}.json
VITE_SCENE_TILE_URL=
# Offline map corridor caching is implemented in the browser service worker.
# Provider terms must permit caching before enabling it for a production deployment.
VITE_OFFLINE_MAP_CACHE=true
